{
  "template": "潭州高架桥（计算稿模板）.xlsx",
  "output": "final.xlsx",
  "sheets": [
    {
      "name": "合计数量",
      "order": 1,
      "purpose": "按厚度汇总，图纸数量 vs 复核数量",
      "header_rows": [1, 2, 3],
      "columns": {"A": "部位", "B": "板厚", "C": "单位", "D": "图纸数量-Q355", "E": "图纸数量-Q420", "F": "图纸数量-合计", "G": "复核数量", "H": "差异", "I": "备注"},
      "formula_columns": {"F": "=D+E", "H": "=G-F", "G": "跨sheet引用明细汇总"},
      "cross_refs": ["主梁数量!按厚度汇总行", "横隔板!按厚度汇总行", "附属预埋件!按厚度汇总行", "主梁数量!焊缝行/其他行", "横隔板!焊缝行/其他行", "附属预埋件!护栏/路灯行"]
    },
    {
      "name": "主梁数量",
      "order": 2,
      "purpose": "主桁/主桁拼接 明细（图纸工程数量表页20 按材质+板厚）",
      "header_rows": [1, 2, 3],
      "columns": {"A": "梁板编号", "B": "板件名称", "C": "位置", "D": "材质", "E": "长-mm", "F": "宽-mm", "G": "厚-mm", "H": "数量", "I": "单件重-kg", "J": "全桥数量", "K": "合计重量-kg", "L": "备注", "N..AC": "按板厚汇总(8..100)", "AD": "合计"},
      "formula_columns": {"K": "=I*J", "小计": "=SUM(K..)", "按厚度汇总": "=SUMIF(G区间,厚表头,K区间)"}
    },
    {
      "name": "横隔板",
      "order": 3,
      "purpose": "上层桥面系构件明细（图纸上层桥面系材料数量表 页232）",
      "header_rows": [1, 2, 3],
      "columns": {"A": "梁板编号", "B": "板件名称", "C": "位置", "D": "材质", "E": "长-mm", "F": "宽-mm", "G": "厚-mm", "H": "数量", "I": "单件重-kg", "J": "全桥数量", "K": "合计重量-kg", "L": "备注", "M": "面积A-m2", "N..AC": "按板厚汇总(8..100)", "AD": "合计"},
      "formula_columns": {"I": "=IF(M=\"\",(E/1000)*(F/1000)*(G/1000)*7850,M*(G/1000)*7850)", "K": "=I*J", "小计": "=SUM(K..)", "按厚度汇总": "=SUMIF(G区间,厚表头,K区间)"}
    },
    {
      "name": "梁底挡块",
      "order": 4,
      "purpose": "梁底挡块（本册为上层图册，无数据，待设计核实）",
      "header_rows": [1, 2, 3]
    },
    {
      "name": "附属预埋件",
      "order": 5,
      "purpose": "附属工程（防撞护栏/路灯底座/伸缩缝/集中排水）",
      "header_rows": [1, 2, 3],
      "columns": {"A": "梁板编号", "B": "板件名称", "C": "位置", "D": "材质", "G": "厚-mm", "I": "单件重-kg", "K": "合计重量-kg", "N..AC": "按板厚汇总(8..100)", "AD": "合计"},
      "formula_columns": {"K": "=I*J", "小计": "=SUM(K..)", "按厚度汇总": "=SUMIF(G区间,厚表头,K区间)"}
    }
  ],
  "material_mapping": {"Q420D/Q420MD": "Q420", "Q355D/Q355C/Q355B/Q355MD": "Q355"},
  "thickness_set": [8, 10, 12, 14, 16, 20, 24, 28, 32, 36, 40, 44, 48, 60, 80, 100]
}
